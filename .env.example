# Read by Compose itself (not by XCP Pulse) purely to fill in "${DOCKER_GID}"
# in docker-compose.yml's group_add line. Only needed if you've enabled
# self-update (see docs/configuration.md) and uncommented the docker.sock
# mount and group_add block in docker-compose.yml.
#
# Copy this file to ".env" next to docker-compose.yml and set the real value
# with:
#
#   echo "DOCKER_GID=$(getent group docker | cut -d: -f3)" > .env
#
# This is a completely different file from xcp-pulse.env, which holds the
# app's own configuration — see xcp-pulse.env.example and its comment for why
# the two are kept separate.
DOCKER_GID=
