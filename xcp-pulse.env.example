# XCP Pulse configuration.
#
# Copy this file to xcp-pulse.env and fill it in:
#     cp xcp-pulse.env.example xcp-pulse.env
#
# The name matters: compose auto-loads a file called .env as its own variable
# source, which mangles the Argon2 hash below.
#
# xcp-pulse.env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The admin username used at the login screen.
XCP_PULSE_ADMIN_USER=admin

# Argon2id hash of the admin password. XCP Pulse refuses to start without it,
# and never falls back to a default password.
#
# Generate one with:
#     docker compose run --rm xcp-pulse python -m app.hashpw
#
# Paste the printed value here. It begins with $argon2id$ — keep it on one line.
XCP_PULSE_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Signs session cookies. Leave blank and one is generated on first boot and
# stored at /data/secret_key, so sessions survive a restart. Set it explicitly
# if you want to control it. Changing it logs everyone out.
#XCP_PULSE_SECRET_KEY=

# Serve HTTPS with a built-in nginx, no reverse proxy of your own required.
# Off by default: a deployment with nothing in front of it keeps working over
# plain HTTP exactly as before. When true, nginx generates a self-signed
# certificate on first run (replace it with your own from Settings once
# logged in), listens on 8443 for HTTPS and on 8080 for a redirect to it, and
# XCP_PULSE_HTTPS below is set for you — you do not need to also set it.
XCP_PULSE_ENABLE_HTTPS=false

# Set to true when XCP Pulse is served over HTTPS by something other than its
# own built-in nginx above — an external reverse proxy you run yourself.
# Adds the Secure flag to the session cookie. Leave false for plain http, or
# the browser will discard the cookie and login will appear to fail.
XCP_PULSE_HTTPS=false

# How long a session lasts, in hours. The clock slides forward on use.
XCP_PULSE_SESSION_HOURS=12

# Login throttling: this many failures from one address inside the window
# blocks further attempts until the window passes.
XCP_PULSE_LOGIN_MAX_ATTEMPTS=5
XCP_PULSE_LOGIN_LOCKOUT_MINUTES=15

# Where the database, session key and collected bundles live inside the
# container. Change the volume in docker-compose.yml rather than this, normally.
XCP_PULSE_DATA_DIR=/data

# DEBUG, INFO, WARNING or ERROR.
XCP_PULSE_LOG_LEVEL=INFO

# Check for and apply updates from the in-app Update page, instead of running
# `docker compose pull && docker compose up -d` by hand. Off by default:
# applying an update needs the Docker socket, which is effectively host root,
# so this stays opt-in. Turning it on alone does nothing — you must also
# uncomment the Docker socket volume and the group_add block in
# docker-compose.yml. See docs/configuration.md for the full picture,
# including the separate (genuinely bare) .env file that group_add needs.
XCP_PULSE_ENABLE_SELF_UPDATE=false

# The directory on the HOST that docker-compose.yml lives in — not a path
# inside this container. Required for self-update: applying an update runs
# `docker compose` against the host's Docker daemon, and it needs this to
# resolve the same project name and the same relative volume paths (like
# ./data above) that your original `docker compose up -d` did.
XCP_PULSE_COMPOSE_PROJECT_DIR=
