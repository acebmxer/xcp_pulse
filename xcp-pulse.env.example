# XCP Pulse configuration.
#
# Copy this file to xcp-pulse.env and fill it in:
#     cp xcp-pulse.env.example xcp-pulse.env
#
# The name matters: compose auto-loads a file called .env as its own variable
# source, which mangles the Argon2 hash below.
#
# xcp-pulse.env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The admin username used at the login screen.
XCP_PULSE_ADMIN_USER=admin

# Argon2id hash of the admin password. XCP Pulse refuses to start without it,
# and never falls back to a default password.
#
# Generate one with:
#     docker compose run --rm xcp-pulse python -m app.hashpw
#
# Paste the printed value here. It begins with $argon2id$ — keep it on one line.
XCP_PULSE_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Signs session cookies. Leave blank and one is generated on first boot and
# stored at /data/secret_key, so sessions survive a restart. Set it explicitly
# if you want to control it. Changing it logs everyone out.
#XCP_PULSE_SECRET_KEY=

# Set to true when XCP Pulse is served over HTTPS (behind a reverse proxy).
# Adds the Secure flag to the session cookie. Leave false for plain http,
# or the browser will discard the cookie and login will appear to fail.
XCP_PULSE_HTTPS=false

# How long a session lasts, in hours. The clock slides forward on use.
XCP_PULSE_SESSION_HOURS=12

# Login throttling: this many failures from one address inside the window
# blocks further attempts until the window passes.
XCP_PULSE_LOGIN_MAX_ATTEMPTS=5
XCP_PULSE_LOGIN_LOCKOUT_MINUTES=15

# Where the database, session key and collected bundles live inside the
# container. Change the volume in compose.yaml rather than this, normally.
XCP_PULSE_DATA_DIR=/data

# DEBUG, INFO, WARNING or ERROR.
XCP_PULSE_LOG_LEVEL=INFO
