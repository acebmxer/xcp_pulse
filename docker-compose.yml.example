services:
  xcp-pulse:
    # Published to GHCR by .github/workflows/release.yml, so this file plus
    # xcp-pulse.env is a complete deployment — no clone and no local build.
    #
    # Working from a clone instead? docker-compose.dev.yml builds the source
    # beside you, and is used alongside this file:
    #
    #   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
    #
    # :latest tracks every release, so "docker compose pull" moves you onto a
    # new version. Pin one instead to stay put until you choose to move —
    # database migrations run at startup, so an upgrade is worth deciding on:
    #
    #   image: ghcr.io/acebmxer/xcp_pulse:0.8.0
    #
    image: ghcr.io/acebmxer/xcp_pulse:latest
    container_name: xcp-pulse
    restart: unless-stopped
    env_file:
      # Deliberately NOT named .env, and deliberately long-form.
      #
      # An Argon2 hash is full of $ ($argon2id$v=19$m=65536,...). Compose treats
      # $ as variable interpolation in two separate places, and both have to be
      # dealt with or the container receives a mangled hash and refuses to start:
      #
      #   1. Values loaded from env_file      -> fixed by "format: raw"
      #   2. Compose auto-loads ./.env as its OWN variable source for
      #      interpolating this file, whatever env_file says -> fixed by not
      #      calling the file .env
      #
      # Together these give a correct hash and no "variable is not set" warnings.
      - path: xcp-pulse.env
        required: true
        format: raw
    ports:
      # Reachable from other machines on your network. Change the left number
      # to move it off 8080; the right one is the port inside the container and
      # never changes. With XCP_PULSE_ENABLE_HTTPS unset or false (the
      # default), this answers the app directly over plain HTTP.
      #
      # To restrict it to the Docker host only — a reverse proxy on the same
      # box, say — put the loopback address in front:
      #
      #   - "127.0.0.1:8080:8080"
      #
      - "8080:8080"
      # Only answers when XCP_PULSE_ENABLE_HTTPS=true, serving the app over
      # HTTPS with a self-signed certificate generated on first run (replace
      # it with your own from Settings once logged in). With that flag unset,
      # nothing listens on 8443 and this mapping is inert — safe to leave in
      # place either way, but comment it out if you'd rather not publish an
      # unused port.
      - "8443:8443"
    volumes:
      # Holds the SQLite database, the session signing key, and (from v0.4.0)
      # collected log bundles. Bundles contain real internal addresses.
      - xcp-pulse-data:/data

volumes:
  xcp-pulse-data:
